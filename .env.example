# Continuity — example environment.
# Copy to `.env` and fill in. NEVER commit a filled-in file.
#
# Rule for this file: no secret, credential, endpoint, or account-specific value
# ever appears here. Non-sensitive defaults (timeouts, limits, log level) ARE
# shown, because they document the expected shape and units of each setting.
# Anything sensitive is left blank.

# ---- Application ----
CONTINUITY_ENV=development
LOG_LEVEL=INFO
# Browser origin the frontend is served from. Required in production; in
# development it defaults to http://localhost:3000.
FRONTEND_ORIGIN=

# ---- Persistence ----
# SQLite in development; PostgreSQL in production.
DATABASE_URL=

# ---- Primary LLM: Google Gemini via Strands ----
# Strands remains the agent framework; Gemini is the model behind it.
GEMINI_API_KEY=
# Defaults to a current tool-capable Gemini model when unset.
GEMINI_MODEL=

# ---- AWS ----
# Credentials come from the standard AWS credential chain (profile,
# environment, or an instance/task role). Do NOT put access keys in this file.
AWS_PROFILE=
AWS_REGION=

# ---- Optional future model provider: Amazon Bedrock ----
# Not in use. The abstraction is kept so Bedrock can be selected later without
# touching any agent.
BEDROCK_MODEL_ID=

# ---- Amazon Bedrock AgentCore (optional; unset => NotConfigured) ----
AGENTCORE_RUNTIME_ARN=
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_OBSERVABILITY_ENABLED=

# ---- GitHub App (optional; unset => NotConfigured) ----
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the App private key file, or the PEM contents.
# Prefer the path. Never commit the key itself.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# ---- User authentication (Google sign-in) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# ---- Agent runtime limits ----
MAX_REPAIR_ATTEMPTS=3
AGENT_MAX_OUTPUT_ATTEMPTS=2
EXECUTION_TIMEOUT_SECONDS=300
EXECUTION_MAX_OUTPUT_BYTES=1048576
CONTEXT_BUDGET_BYTES=200000

# ---- Provider monitoring ----
PROVIDER_POLL_INTERVAL_SECONDS=
PROVIDER_FETCH_TIMEOUT_SECONDS=30

# ---- Frontend (only NEXT_PUBLIC_* reaches the browser) ----
NEXT_PUBLIC_API_BASE_URL=
